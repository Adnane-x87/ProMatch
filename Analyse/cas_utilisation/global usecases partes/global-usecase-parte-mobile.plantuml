@startuml
title Diagramme de Cas d'Utilisation — Mobile (Application)

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #E8F4FD
    BorderColor #2980B9
}

actor "User (Locataire)" as User
actor "Admin (Propriétaire)" as Admin

rectangle "Application Mobile ProMatch" {
    usecase "S'inscrire / Se connecter" as UC_Auth
    usecase "Consulter les terrains publics" as UC_Fields
    usecase "Rechercher les créneaux disponibles" as UC_Slots
    usecase "Réserver un terrain" as UC_Book
    usecase "Uploader sa CNI" as UC_CNI
    usecase "Valider la réservation du client\n(Vérification à l'arrivée)" as UC_Validate
    usecase "Consulter les statistiques" as UC_Stats
}

' User actions (via mobile)
User --> UC_Auth
User --> UC_Fields
User --> UC_Slots
User --> UC_Book
User --> UC_CNI

' Admin actions (via mobile)
Admin --> UC_Validate
Admin --> UC_Stats

@enduml
